 from .base_search import BaseSearch
 from .hill_climbing import HillClimbing
-from .cem import CEM
-from .cebs import CEBS
-from .hill_climbing_latent import HillClimbingLatent
-from .scheduled_hill_climbing import Scheduled_HillClimbing
+
+# The latent-space search methods (CEM, CEBS, HillClimbingLatent, Scheduled_HillClimbing)
+# pull in the heavy torch/h5py latent-space chain. Import them lazily so programmatic-only
+# experiments don't need those dependencies.
+_LAZY = {"CEM": ".cem", "CEBS": ".cebs",
+         "HillClimbingLatent": ".hill_climbing_latent",
+         "Scheduled_HillClimbing": ".scheduled_hill_climbing"}
+
+def __getattr__(name):
+    if name in _LAZY:
+        import importlib
+        mod = importlib.import_module(_LAZY[name], __name__)
+        return getattr(mod, name)
+    raise AttributeError(f"module {__name__!r} has no attribute {name!r}")
 
 def get_search_method_cls(search_cls_name: str) -> type[BaseSearch]:
     search_cls = globals().get(search_cls_name)
+    if search_cls is None:
+        search_cls = __getattr__(search_cls_name)
     assert issubclass(search_cls, BaseSearch)
     return search_cls
